# Copy to .env and fill in the values. Values below are for production (compose.prod.yaml).

# Public domain (Caddy fetches a Let's Encrypt certificate for it)
DOMAIN=boardgames.example.com

# Postgres container
POSTGRES_USER=boardgame
POSTGRES_PASSWORD=change-me
POSTGRES_DB=boardgame

# Backend + Alembic ("db" is the compose service name; use localhost for local dev)
DATABASE_URL=postgresql+psycopg://boardgame:change-me@db:5432/boardgame

# Auth – generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
TOKEN_RENEW_AFTER_HOURS=24

# Production hardening (dev defaults: false / true)
COOKIE_SECURE=true
ENABLE_DOCS=false

# Only needed if the frontend is served from a different origin (JSON list)
# CORS_ORIGINS=["https://boardgames.example.com"]
